# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.

# Interfejs, którym host jest w sieci LAN (sprawdź: ip -br link).
# Raspberry Pi: zwykle eth0 lub end0 (przy Wi-Fi wlan0); VM Proxmox z kartą VirtIO: zwykle ens18.
INFRA_IF=eth0

# Port szeregowy dongla ESP32-C5 (stała nazwa z reguły udev, patrz host/99-thread-rcp.rules.example).
RCP_DEVICE=/dev/thread-rcp
RCP_BAUDRATE=460800

# Konto SUPLA — opcjonalnie; wygodniej wpisać je w panelu WWW (sekcja „Konto SUPLA”).
# Dane zapisane w panelu mają pierwszeństwo przed tymi zmiennymi.
SUPLA_SERVER=
SUPLA_MAIL=

# Hasło panelu WWW. Wymagane tylko, gdy w config/devices.yaml ustawisz web.host inny niż 127.0.0.1.
M2S_WEB_PASSWORD=

TZ=Europe/Warsaw

# Wersja gotowych obrazów z GHCR: numer wydania (np. 0.2.0 dla tagu v0.2.0), latest = ostatnie
# wydanie (domyślnie), edge = gałąź main. host/update.sh wpisuje tu numer instalowanej wersji.
#M2S_VERSION=latest
